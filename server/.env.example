# ==================== MAIL (order invoice emails) ====================
# Sent after every successful checkout with the branded invoice.
# For Gmail use an App Password (not your account password):
#   https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Lira <your-email@gmail.com>
CLIENT_URL=http://localhost:3000

# ==================== PRICING (server-authoritative) ====================
# The client only displays these (GET /api/v1/pricing); order totals are always
# recomputed from them, so a crafted request cannot change what is charged.
SHIPPING_COST=7
# Fraction, not percent: 0.19 = 19 %. 0 = no tax.
TAX_RATE=0
# Subtotal at/above which shipping is waived. Leave unset to always charge shipping.
# FREE_SHIPPING_THRESHOLD=200

