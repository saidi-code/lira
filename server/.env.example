# ==================== AUTH (Clerk) — REQUIRED ====================
# There is no local password login. `server.ts` mounts `clerkMiddleware()` and
# `protect` reads a Clerk session via `req.auth()`, so without these the server
# starts but *every* authenticated route returns 401.
#
# Both are in the Clerk dashboard → API Keys.
# CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Enables the dashboard/frontend, not the server.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Signs inbound Clerk webhooks (Dashboard → Webhooks → Signing Secret).
# Without it `verifyWebhook` throws on EVERY delivery, the local User cache is
# never populated, and `protect` then rejects real customers with
# "user not found in database" — so this is not optional in production.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ==================== DATABASE ====================
# DB_URI=mongodb+srv://user:pass@cluster.mongodb.net/lyra
# DB_NAME=lyra

# ==================== IMAGES (Cloudinary) ====================
# Required for any product create/update; `upload.array` runs before the handler.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ==================== MAIL (order invoice emails) ====================
# Sent after every successful checkout with the branded invoice.
# For Gmail use an App Password (not your account password):
#   https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Lira <your-email@gmail.com>
CLIENT_URL=http://localhost:3000

# ==================== PRICING (server-authoritative) ====================
# The client only displays these (GET /api/v1/pricing); order totals are always
# recomputed from them, so a crafted request cannot change what is charged.
SHIPPING_COST=7
# Fraction, not percent: 0.19 = 19 %. 0 = no tax.
TAX_RATE=0
# Subtotal at/above which shipping is waived. Leave unset to always charge shipping.
# FREE_SHIPPING_THRESHOLD=200

# ==================== ORDER LIFECYCLE ====================
# Minutes an ONLINE order (stripe) may stay unpaid before its stock is released
# and the order cancelled. 0 disables the sweep. COD (`cash`) is never expired —
# it is settled on delivery.
PAYMENT_WINDOW_MINUTES=60
# Shared secret for the scheduler-only endpoints under /api/v1/internal.
# While unset those endpoints answer 503 (closed), never "open".
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

