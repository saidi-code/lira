  {
    "version": 2,
    "builds": [
        {
            "src": "server.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "dist/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "server.ts"
        }
    ],
    "crons": [
        {
            "path": "/api/v1/internal/orders/release-expired",
            "schedule": "0 3 * * *"
        }
    ]
}