{
  "name": "desktop-cashier",
  "version": "1.0.0",
  "description": "Lira desktop POS app — receipt printing, USB scanner, kiosk",
  "author": "Lira",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"npm:dev:vite\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:vite": "vite --config src/renderer/vite.config.ts",
    "dev:main": "tsc -p tsconfig.main.json -w --preserveWatchOutput",
    "dev:electron": "electron .",
    "dev:main:run": "npm run build:main && electron .",
    "build": "npm run build:main && tsc --noEmit -p src/renderer/tsconfig.json && vite build --config src/renderer/vite.config.ts && electron-builder",
    "build:main": "tsc -p tsconfig.main.json",
    "preview": "vite preview --config src/renderer/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "start": "electron ."
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.31.0",
    "@lira/shared": "file:../../packages/shared",
    "electron-pos-printer": "^1.3.4",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-reloader": "^1.2.3",
    "typescript": "^5.8.2",
    "vite": "^5.4.14"
  }
}

